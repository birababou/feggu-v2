APP_NAME=FEGGU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- FEGGU ---
FEGGU_CODE_SOURCE_URL=https://github.com/birababou/feggu-v2
FEGGU_DEMO=false
FEGGU_ADMIN_EMAIL=admin@feggu.org
FEGGU_ADMIN_PASSWORD=
FEGGU_2FA_ROLES=admin
FEGGU_NUMERO_COURT=21211
FEGGU_CODE_USSD=
FEGGU_NUMERO_WHATSAPP=
FEGGU_NUMERO_VOCAL=

# Webhooks des canaux : jeton long et aléatoire (openssl rand -hex 32)
FEGGU_WEBHOOK_TOKEN=
FEGGU_WEBHOOK_IPS=

# SMS sortants (LAM). Ne jamais mettre ces identifiants dans le code.
FEGGU_SMS_DRIVER=log
FEGGU_SMS_EXPEDITEUR=INFO
LAM_SMS_URL=
LAM_SMS_USER=
LAM_SMS_PASSWORD=

# WhatsApp Business (API Cloud de Meta)
FEGGU_WHATSAPP_DRIVER=log
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# IA locale (Ollama, vLLM...), facultative
FEGGU_IA_URL=
FEGGU_IA_MODELE=llama3.1
FEGGU_IA_CLE=
# Assistante conversationnelle (nécessite FEGGU_IA_URL). Canaux : web, whatsapp, sms (jamais ussd).
FEGGU_ASSISTANT=true
FEGGU_ASSISTANT_CANAUX=web,whatsapp
FEGGU_ASSISTANT_TIMEOUT=45
FEGGU_ASSISTANT_REDACTION=false
FEGGU_TRANSCRIPTION_URL=

# Ancienne base v1 (reprise des données, sur le serveur uniquement)
V1_DB_HOST=127.0.0.1
V1_DB_DATABASE=feggu
V1_DB_USERNAME=feggu
V1_DB_PASSWORD=
